# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env est ignoré par Git : vos clés restent sur votre machine.

# Clé API Mistral : https://console.mistral.ai
MISTRAL_API_KEY=

# Elasticsearch
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=translator
